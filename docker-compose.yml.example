services:
  multica:
    image: ${IMAGE_NAME:-ghcr.io/i94m/multica-runtime}:${MULTICA_VERSION:-0.6.3}
    working_dir: /workspace
    stdin_open: true
    tty: true
    volumes:
      # Persistent runtime state. Do not commit these folders.
      - ./workspace:/workspace
      - ./multica:/root/.multica
      - ./multica-workspaces:/root/multica_workspaces
      - ./opencode-config:/root/.config/opencode
      - ./opencode-data:/root/.local/share/opencode
      # Optional: mount a dedicated read-only SSH key for git access.
      # Uncomment and adjust the key path if needed; do not bake SSH keys into the image.
      # - ~/.ssh/id_ed25519:/root/.ssh/id_ed25519:ro
      # - ~/.ssh/id_ed25519.pub:/root/.ssh/id_ed25519.pub:ro
      # - ~/.ssh/known_hosts:/root/.ssh/known_hosts:ro
    restart: unless-stopped
    networks:
      - multica_net

networks:
  multica_net:
    driver: bridge
    ipam:
      config:
        - subnet: ${MULTICA_DOCKER_SUBNET:-172.31.250.0/24}
