# Copy to .env before running docker compose if you want to override versions.
IMAGE_NAME=ghcr.io/i94m/multica-runtime
MULTICA_VERSION=0.7.0

# Dockerfile defaults, useful for local builds. The release workflow only
# passes BASE_IMAGE and MULTICA_VERSION.
BASE_IMAGE=docker.m.daocloud.io/library/debian:13-slim
NODE_VERSION=24.21.0
UV_VERSION=latest
OPENCODE_VERSION=2.1.0
MYSQL_MCP_VERSION=2.0.9
